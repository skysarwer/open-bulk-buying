{
	"name": "open-bulk-buying",
	"version": "1.0.0",
	"description": "Inventory management, order cycles and order forms for Food Coops",
	"author": "Evan Buckiewicz",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build && node scripts/clean-build-maps.js",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"i18n:extract": "wp i18n make-pot . languages/open-bulk-buying.pot --domain=open-bulk-buying --exclude=node_modules,vendor,tests,ref,build",
		"i18n:update": "wp i18n update-po languages/open-bulk-buying.pot languages",
		"i18n:compile": "node scripts/compile-translations.js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"files": [
		"assets",
		"build",
		"inc/**/*.php",
		"languages",
		"open-bulk-buying.php",
		"uninstall.php",
		"readme.txt"
	],
	"devDependencies": {
		"@wordpress/scripts": "^31.4.0"
	},
	"dependencies": {
		"@wordpress/dataviews": "^20.0.0",
		"@wordpress/icons": "^18.0.0"
	}
}
