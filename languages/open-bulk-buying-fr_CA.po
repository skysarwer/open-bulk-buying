#. translators: %s: site name.
#: inc/emails/account-exists.php:12
#, php-format
msgid "[%s] You already have an account"
msgstr "[%s] Vous avez déjà un compte"

#. translators: 1: site name, 2: login URL, 3: lost password URL.
#: inc/emails/account-exists.php:15
#, php-format
msgid ""
"Someone, hopefully you, tried to sign up to %1$s with this email address. You already have an account, so there's no code to enter.\n"
"\n"
"Log in to finish joining:\n"
"%2$s\n"
"\n"
"Forgot your password? Reset it here:\n"
"%3$s\n"
"\n"
"If this wasn't you, you can ignore this email."
msgstr ""
"Quelqu’un, vous peut-être, a tenté de s’inscrire à %1$s avec cette adresse courriel. Vous avez déjà un compte; il n’y a donc aucun code à saisir.\n"
"\n"
"Connectez-vous pour terminer votre adhésion :\n"
"%2$s\n"
"\n"
"Vous avez oublié votre mot de passe? Réinitialisez-le ici :\n"
"%3$s\n"
"\n"
"Si vous n’êtes pas à l’origine de cette demande, vous pouvez ignorer ce courriel."

#. translators: 1: member's first name, 2: site name.
#: inc/emails/application-pending.php:11
#, php-format
msgid ""
"Hi %1$s,\n"
"\n"
"Thanks for applying to join %2$s. A coordinator will review your application. You'll be able to place orders once it's approved."
msgstr ""
"Bonjour %1$s,\n"
"\n"
"Merci d’avoir demandé à devenir membre de %2$s. Une personne responsable de la coordination examinera votre demande. Vous pourrez passer des commandes une fois votre demande approuvée."

#. translators: %s: site name.
#: inc/emails/application-pending.php:15
#, php-format
msgid "[%s] We received your membership application"
msgstr "[%s] Nous avons reçu votre demande d’adhésion"

#. translators: 1: site name, 2: the code.
#: inc/emails/login-code.php:12
#, php-format
msgid "[%1$s] Your login code: %2$s"
msgstr "[%1$s] Votre code de connexion : %2$s"

#. translators: 1: site name.
#: inc/emails/login-code.php:16
#, php-format
msgid "Enter this code in the browser where you asked to log in to %s:"
msgstr "Saisissez ce code dans le navigateur où vous avez demandé à vous connecter à %s :"

#. translators: %d: minutes until the code expires.
#: inc/emails/login-code.php:22
#, php-format
msgid "The code works once and expires in %d minutes. Don't share it with anyone."
msgstr "Le code est à usage unique et expire dans %d minutes. Ne le communiquez à personne."

#: inc/emails/login-code.php:25
msgid "If you didn't ask to log in, you can ignore this email."
msgstr "Si vous n’avez pas demandé à vous connecter, vous pouvez ignorer ce courriel."

#. translators: 1: login URL, 2: lost password URL.
#: inc/emails/member-login-instructions.php:12
#, php-format
