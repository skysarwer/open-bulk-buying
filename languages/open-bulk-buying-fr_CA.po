msgid "Set in wp-config.php with OPENBB_TURNSTILE_SECRET."
msgstr "Définie dans wp-config.php avec OPENBB_TURNSTILE_SECRET."

#: src/admin/screens/settings/general.js:207
msgid "A secret key is saved. Leave this empty to keep it."
msgstr "Une clé secrète est enregistrée. Laissez ce champ vide pour la conserver."

